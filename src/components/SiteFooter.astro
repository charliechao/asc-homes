---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="container footer-grid footer-grid-simple">
    <div class="footer-brand">
      <p>
        Design-led homes, project management, and construction delivered with a
        quiet luxury sensibility.
      </p>
    </div>

    <div>
      <p class="footer-label">Contact</p>
      <ul class="footer-list">
        <li>
          <a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
      </ul>
    </div>

    <div class="footer-credit-row">
      <a
        class="footer-credit"
        href="https://www.kiwiwebdesign.co.nz/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Website by Kiwi Web Design"
      >
        <span>Website by</span>
        <img src="/brand/kwd.webp" alt="Kiwi Web Design" loading="lazy" />
      </a>
    </div>
  </div>
</footer>
