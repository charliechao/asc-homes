---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../data/site";

type Props = {
  title?: string;
  description?: string;
  bodyClass?: string;
};

const {
  title = site.title,
  description = site.description,
  bodyClass = ""
} = Astro.props;
const currentPath = Astro.url.pathname;

const normalizePath = (value: string) => {
  if (!value) return "/";
  const trimmed = value.endsWith("/") ? value : `${value}/`;
  return trimmed === "//" ? "/" : trimmed;
};

const isCurrent = (href: string) => {
  const current = normalizePath(currentPath);
  const target = normalizePath(href);
  return target === "/" ? current === "/" : current.startsWith(target);
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/brand/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <div class="site-frame">
      <SiteHeader currentPath={currentPath} />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <details class="mobile-nav-floating">
      <summary aria-label="Open menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "nav-link",
                item.featured && "is-featured",
                isCurrent(item.href) && "is-current"
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
