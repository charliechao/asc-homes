---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  companyStory,
  teamMembers
} from "../data/about";
---

<BaseLayout title="About Us | ASC Homes">
  <div class="page-shell about-shell">
    <div class="container">
      <section class="interior-hero about-opening">
        <div class="interior-hero-copy">
          <h1>About Us</h1>
          <div class="intro-copy">
            {companyStory.intro.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>

        <div class="interior-hero-image">
          <img src="/home/about-us-construction.jpg" alt="ASC Homes construction project in progress" />
        </div>
      </section>

      <section class="about-team">
        <div class="section-heading">
          <h2>OUR TEAM</h2>
        </div>

        <div class="team-grid">
          {
            teamMembers.map((member) => (
              <article class="team-card">
                <div class="team-card-image">
                  <img src={member.image} alt={member.imageAlt} />
                </div>
                <p class="team-role">{member.role}</p>
                <h3>{member.name}</h3>
                <div class="team-bio">
                  {member.bio.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
