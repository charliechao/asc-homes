---
import Web3Form from "../components/Web3Form.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contact Us | ASC Homes">
  <div class="page-shell contact-shell">
    <div class="container">
      <section class="contact-grid">
        <div class="contact-copy">
          <p class="contact-quote">"Your Vision, Our Expertise."</p>
          <p class="intro-copy">
            At ASC Homes, we specialize in bespoke homes and high-quality
            construction. Get in touch today for a free consultation and let's
            build something extraordinary together.
          </p>

          <div class="contact-action-panel">
            <p>
              Ready to start your dream project?<br />
              Contact us today!
            </p>
            <a class="contact-action-button" href={`tel:${site.contact.phone}`}>
              Call Us
            </a>
            <a class="contact-action-button" href={`mailto:${site.contact.email}`}>
              Email Us
            </a>
          </div>
        </div>

        <Web3Form
          formTitle="CONTACT US"
          formIntro="Get a Free Estimate"
          submitLabel="Send Message"
          subject="ASC Homes Contact Enquiry"
          source="contact-page"
        >
          <label class="form-field">
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label class="form-field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label class="form-field">
            <span>Phone</span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>

          <label class="form-field form-field-full">
            <span>Message</span>
            <textarea
              name="message"
              rows="5"
              required
            ></textarea>
          </label>
        </Web3Form>
      </section>
    </div>
  </div>
</BaseLayout>
