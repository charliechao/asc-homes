---
import BaseLayout from "../layouts/BaseLayout.astro";
import { processSteps } from "../data/home";
---

<BaseLayout title="Design & Build | ASC Homes">
  <section class="design-build-video-hero">
    <div
      class="hero-poster"
      aria-hidden="true"
      style="background-image: url('/home/weiti-bay.png');"
    ></div>
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/home/weiti-bay.png"
      aria-label="ASC Homes design and build video"
      data-design-hero-video
    >
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
  </section>

  <div class="page-shell design-build-shell">
    <div class="container">
      <section class="design-build-feature">
        <div class="design-feature-panel">
          <div class="design-feature-image">
            <img src="/home/design-build-why-asc-homes.jpg" alt="Completed ASC Homes design and build project with pool" />
          </div>
          <div class="design-feature-copy">
            <h2>WHY ASC HOMES</h2>
            <p>
              Architecture, Construction, Interior design, and Project
              management, delivered through one coordinated team.
            </p>
            <p>
              ASC Homes provides a complete residential design and build
              service, bringing together architectural design, construction,
              interior design, and project management within one integrated
              process.
            </p>
            <p>
              From early feasibility and concept planning through to
              construction delivery and final handover, we create a smoother
              building experience with greater clarity, accountability, and
              consistency throughout every stage of the project.
            </p>
            <p>
              Our integrated approach ensures that design intent, construction
              quality, interior detailing, and budget considerations remain
              aligned from beginning to completion.
            </p>
            <p>
              Combining practical construction expertise with refined design
              thinking, we deliver homes that are functional, well-considered,
              and built to a high standard.
            </p>
            <p>
              We believe successful projects are built on strong communication,
              transparency, and long-term client relationships ensuring every
              project is managed with professionalism, care, and attention to
              detail.
            </p>
          </div>
        </div>
      </section>

      <section class="process-section">
        <div class="process-grid">
          {
            processSteps.map((step) => (
              <article class="process-card">
                <span class="process-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const designHeroVideo = document.querySelector("[data-design-hero-video]");

  if (designHeroVideo instanceof HTMLVideoElement) {
    const revealVideo = () => {
      designHeroVideo.classList.add("is-ready");
    };

    if (designHeroVideo.readyState >= 2) {
      revealVideo();
    } else {
      designHeroVideo.addEventListener("loadeddata", revealVideo, { once: true });
      designHeroVideo.addEventListener("canplay", revealVideo, { once: true });
    }
  }
</script>
