---
import BaseLayout from "../layouts/BaseLayout.astro";
import { processSteps } from "../data/home";
---

<BaseLayout title="Design & Build | ASC Homes">
  <section class="design-build-video-hero">
    <div
      class="hero-poster"
      aria-hidden="true"
      style="background-image: url('/home/weiti-bay.png');"
    ></div>
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/home/weiti-bay.png"
      aria-label="ASC Homes design and build video"
      data-design-hero-video
    >
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    <div class="design-build-video-title">
      <h1>
        <span>Your Vision</span>
        <span>Our Expertise</span>
      </h1>
    </div>
  </section>

  <div class="page-shell design-build-shell">
    <div class="container">
      <section class="design-build-feature">
        <div class="design-feature-panel">
          <div class="design-feature-image">
            <img src="/home/weiti-bay.png" alt="Weiti Bay featured project" />
          </div>
          <div class="design-feature-copy">
            <h2>Design intent stays connected to build reality.</h2>
            <p>
              The process is shaped for homeowners who want clarity,
              accountability, and fewer disconnects between design decisions and
              construction delivery.
            </p>
          </div>
        </div>
      </section>

      <section class="process-section">
        <div class="process-grid">
          {
            processSteps.map((step) => (
              <article class="process-card">
                <span class="process-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const designHeroVideo = document.querySelector("[data-design-hero-video]");

  if (designHeroVideo instanceof HTMLVideoElement) {
    const revealVideo = () => {
      designHeroVideo.classList.add("is-ready");
    };

    if (designHeroVideo.readyState >= 2) {
      revealVideo();
    } else {
      designHeroVideo.addEventListener("loadeddata", revealVideo, { once: true });
      designHeroVideo.addEventListener("canplay", revealVideo, { once: true });
    }
  }
</script>
