---
import BaseLayout from "../layouts/BaseLayout.astro";
import { serviceList } from "../data/about";
import { partnerLinks } from "../data/home";

const clientReviews = [
  {
    quote:
      "We were looking for a builder who could handle a technically demanding project, and ASC Homes delivered with precision and excellence. Their professionalism, problem-solving skills, and craftsmanship exceeded our expectations. We now have a home that is both stunning and structurally exceptional.",
    client: "Chris & Laura"
  },
  {
    quote:
      "ASC Homes took on our complex project with confidence and delivered beyond our expectations. Their ability to navigate challenges while maintaining quality and efficiency was outstanding. Our home is not only beautiful but also built to the highest standard. We highly recommend them!",
    client: "James & Olivia, Browns Bay"
  }
] as const;
---

<BaseLayout
  title="ASC Homes | Building Excellence Beyond the Ordinary"
  description="Design-led homes, bespoke construction, and project delivery by ASC Homes."
  bodyClass="is-home"
>
  <section class="home-hero">
    <div
      class="hero-poster"
      aria-hidden="true"
      style="background-image: url('/home/weiti-bay.png');"
    ></div>

    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/home/weiti-bay.png"
      aria-label="ASC Homes hero video"
      data-hero-video
    >
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>

    <div class="hero-overlay"></div>

    <a class="hero-scroll" href="#story" aria-label="Scroll to story section">
      <span></span>
    </a>
  </section>

  <div class="page-shell homepage-shell">
    <section class="home-reference-row home-reference-row-top" id="story">
      <div class="home-reference-copy" data-reveal>
        <h2>BEYOND THE ORDINARY</h2>
        <p>
          Every home should be as unique as its owner. With a keen eye for
          detail, custom-crafted fixtures, and innovative design.
        </p>
        <p>
          From the initial concept to the final build, we work closely with
          you and our expert architects to ensure every detail aligns with
          your vision and lifestyle. Creating a home that suits you, inside
          and out, is our top priority
        </p>
        <a class="home-reference-link" href="/our-work/">View Our Work</a>
      </div>

      <div class="home-reference-image" data-reveal>
        <img src="/home/beyond-the-ordinary.jpg" alt="Architectural home at dusk" />
      </div>
    </section>

    <section class="home-reference-row home-reference-row-bottom">
      <div class="home-reference-image" data-reveal>
        <img src="/home/what-we-do.jpg" alt="ASC Homes construction project with scaffolding" />
      </div>

      <div class="home-reference-copy" data-reveal>
        <h2>What We Do</h2>
        <ul class="about-service-list">
          {
            serviceList.map((service) => (
              <li>{service}</li>
            ))
          }
        </ul>
        <a class="home-reference-link" href="/design-build/">Learn More</a>
      </div>
    </section>

    <section class="home-client-experience" data-home-reviews>
      <button class="testimonial-arrow" type="button" data-review-direction="-1" aria-label="Previous testimonial">
        <span>&larr;</span>
      </button>

      <article class="home-client-quote">
        <div class="home-client-track" data-home-review-track>
          {
            clientReviews.map((review, index) => (
              <div class="home-client-slide" aria-hidden={index === 0 ? "false" : "true"}>
                <p class="home-client-stars">★★★★★</p>
                <blockquote>"{review.quote}"</blockquote>
                <p class="home-client-name">{review.client}</p>
              </div>
            ))
          }
        </div>
        <div class="home-client-dots" aria-label="Client review slides">
          {
            clientReviews.map((_, index) => (
              <button
                class:list={["home-client-dot", index === 0 && "is-active"]}
                type="button"
                data-review-dot={index}
                aria-label={`Show review ${index + 1}`}
              ></button>
            ))
          }
        </div>
      </article>

      <button class="testimonial-arrow" type="button" data-review-direction="1" aria-label="Next testimonial">
        <span>&rarr;</span>
      </button>
    </section>

    <section class="home-trusted-logos" aria-label="Trusted connections">
      <div class="container">
        <div class="partner-strip home-logo-strip">
          {
            partnerLinks.map((partner) => (
              <div
                class:list={[
                  "partner-chip",
                  "is-centered-logo",
                  partner.label === "Master Builders NZ" && "is-compact-logo",
                  partner.label === "Site Safe Member" && "is-tall-logo",
                  partner.label === "ADNZ" && "is-adnz-logo"
                ]}
                role="img"
                aria-label={partner.imageAlt}
              >
                <span class="partner-logo-wrap">
                  <img
                    class="partner-logo-image"
                    src={partner.image}
                    alt={partner.imageAlt}
                    loading="lazy"
                  />
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  const reveals = document.querySelectorAll("[data-reveal]");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.22 }
    );

    reveals.forEach((item) => observer.observe(item));
  } else {
    reveals.forEach((item) => item.classList.add("is-visible"));
  }

  const heroVideo = document.querySelector("[data-hero-video]");

  if (heroVideo instanceof HTMLVideoElement) {
    const revealVideo = () => {
      heroVideo.classList.add("is-ready");
    };

    if (heroVideo.readyState >= 2) {
      revealVideo();
    } else {
      heroVideo.addEventListener("loadeddata", revealVideo, { once: true });
      heroVideo.addEventListener("canplay", revealVideo, { once: true });
    }
  }

  const reviewSection = document.querySelector("[data-home-reviews]");

  if (reviewSection) {
    const slides = Array.from(reviewSection.querySelectorAll(".home-client-slide"));
    const dots = Array.from(reviewSection.querySelectorAll("[data-review-dot]"));
    const buttons = Array.from(reviewSection.querySelectorAll("[data-review-direction]"));
    let index = 0;
    let timer;

    const setReview = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === index;
        slide.classList.toggle("is-active", isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });

      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === index);
      });
    };

    const startReviews = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => setReview(index + 1), 6000);
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        setReview(index + Number(button.dataset.reviewDirection || "1"));
        startReviews();
      });
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        setReview(Number(dot.dataset.reviewDot || "0"));
        startReviews();
      });
    });

    setReview(0);
    startReviews();
  }
</script>
