---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";

const showcaseProjects = projects.slice(0, 7);
const libraryProjects = projects.slice(7);
const allProjects = [...showcaseProjects, ...libraryProjects];

const getProjectArea = (project: (typeof projects)[number]) => project.suburb || project.location;
---

<BaseLayout title="Our Work | ASC Homes">
  <div class="page-shell portfolio-shell">
    <div class="container">
      <section class="portfolio-transition">
        <h1>OUR WORK</h1>
      </section>

      <section class="portfolio-composition portfolio-square-grid">
        {
          allProjects.map((project, index) => (
            <a
              class="portfolio-composition-card"
              href={`/our-work/${project.slug}/`}
            >
              <img src={project.coverImage} alt={project.coverAlt} />
              <div class="portfolio-composition-overlay">
                <p class="portfolio-suburb">{getProjectArea(project)}</p>
              </div>
            </a>
          ))
        }
      </section>
    </div>
  </div>
</BaseLayout>
